# Copy to .env (gitignored) and edit. .env is the ONLY place secrets live.
# The values below are placeholders, not real credentials.

# --- Local PostgreSQL (docker compose) ---
# POSTGRES_PASSWORD must match the password inside DATABASE_URL below.
POSTGRES_VERSION=17
POSTGRES_USER=scamshield
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=scamshield
POSTGRES_PORT=5432

# --- App ---
# Runtime connection. Local: the Docker Postgres above.
# Supabase (deployed): the transaction pooler string; the same code works for both.
DATABASE_URL=postgresql://scamshield:change-me-local@localhost:5432/scamshield

# Migrations only (direct/session connection). Leave empty locally to reuse DATABASE_URL.
DATABASE_URL_MIGRATE=

# LLM key (Groq). Used by the model-spike runner (`npm run eval:q08`) and by POST /api/analyses.
# /api/health does not depend on it.
# To rotate: change the value here and restart `npm run dev`. On Vercel: edit the variable in the
# project settings, then redeploy.
GROQ_API_KEY=

# --- Analysis pipeline (POST /api/analyses) ---
# Models (Q-08). Fallback if the primary fails or is rate limited: openai/gpt-oss-120b.
GROQ_MODEL_SIGNALS=qwen/qwen3.8-27b
GROQ_MODEL_EXPLAIN=qwen/qwen3.8-27b
# Optional, defaults to low (the setting measured in docs/research/result.md A.6).
GROQ_REASONING_EFFORT=

# Secret for hashing client IPs in the rate limiter. Required, at least 32 random characters,
# for example the output of: openssl rand -hex 32
RATE_LIMIT_SALT=

# Optional cap on LLM calls per day (Vietnam time). Empty: no cap.
LLM_DAILY_CALL_CAP=

# Optional, not used yet (T-035).
SAFE_BROWSING_API_KEY=

# --- FraudOps demo accounts (npm run demo:seed) ---
# Five passwords for judge1…judge5, comma separated, each 12 to 200 characters without commas.
# The owner keeps the real values in .env only; running demo:seed again changes the passwords.
DEMO_STAFF_PASSWORDS=
