{
  "name": "scamshield-ops",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "eval"
  ],
  "scripts": {
    "dev": "npm run dev -w @scamshield/web",
    "build": "npm run build -w @scamshield/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run db:generate -w @scamshield/core",
    "db:migrate": "npm run db:migrate -w @scamshield/core",
    "demo:seed": "tsx packages/core/scripts/demo-seed.ts",
    "eval:q08": "tsx eval/src/run-q08.ts",
    "eval": "tsx eval/src/run-eval.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
