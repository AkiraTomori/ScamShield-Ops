{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "enabledPlugins": {
    "sdlc@sdlc-kit": true
  },
  "extraKnownMarketplaces": {
    "sdlc-kit": {
      "source": {
        "source": "directory",
        "path": "./tools/sdlc-kit"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-sync-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
